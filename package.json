{
  "name": "discord-activity-webrtc-screenshare",
  "version": "1.0.0",
  "description": "PoC para teste de compartilhamento de tela com áudio (WebRTC) em Discord Activities",
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron desktop/main.js",
    "desktop": "electron desktop/main.js",
    "server": "node --watch server.js",
    "dev:server": "node --watch server.js",
    "tunnel:cloudflared": "cloudflared tunnel --url http://localhost:3000",
    "tunnel:localtunnel": "npx localtunnel --port 3000",
    "tunnel:ngrok": "ngrok http 3000"
  },
  "keywords": [
    "discord-activity",
    "webrtc",
    "getdisplaymedia",
    "screen-sharing",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "localtunnel": "^2.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.4.0"
  }
}
